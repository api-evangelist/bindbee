{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bindbee Candidates Jobs API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bindbee List Jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bindbee.dev/v1/ats/jobs",
            "headers": [
              {
                "name": "x-connector-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by job status."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of job postings from the connected ATS system."
        }
      ]
    }
  ],
  "bundled": true
}