{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bindbee Candidates Departments API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Departments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bindbee List Departments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bindbee.dev/v1/hris/departments",
            "headers": [
              {
                "name": "x-connector-token",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of departments from the connected HRIS system."
        }
      ]
    }
  ],
  "bundled": true
}