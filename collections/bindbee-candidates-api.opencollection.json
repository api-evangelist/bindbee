{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bindbee Candidates API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Candidates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bindbee List Candidates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bindbee.dev/v1/ats/candidates",
            "headers": [
              {
                "name": "x-connector-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "query",
                "description": "Filter by job ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of candidates from the connected ATS system."
        },
        {
          "info": {
            "name": "Bindbee Get Candidate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bindbee.dev/v1/ats/candidates/:id",
            "headers": [
              {
                "name": "x-connector-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "cand-abc123",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a single candidate record by ID."
        }
      ]
    }
  ],
  "bundled": true
}